#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git

write_files:
  - path: /root/clawdbot.env
    permissions: "0600"
    content: |
      # generated by cloud-init
      CLAWDBOT_CONFIG_DIR=/root/.clawdbot
      CLAWDBOT_WORKSPACE_DIR=/root/clawd

      GATEWAY_PORT=${gateway_port}
      GATEWAY_AUTH_TOKEN=${gateway_auth_token}

      TELEGRAM_BOT_TOKEN=${telegram_bot_token}
      TELEGRAM_ALLOW_FROM=${telegram_allow_from}

      # Model provider
      ANTHROPIC_API_KEY=${anthropic_api_key}

      # Optional LiteLLM
      LITELLM_BASE_URL=${litellm_base_url}
      LITELLM_API_KEY=${litellm_api_key}

      # Optional web search
      BRAVE_API_KEY=${brave_api_key}

runcmd:
  - mkdir -p /root/.clawdbot /root/clawd
  - chown -R 1000:1000 /root/.clawdbot /root/clawd
  - curl -fsSL https://get.docker.com | sh
  - rm -rf /opt/clawdbot-docker-deploy
  - |
    /bin/bash <<'EOF'
    set -euo pipefail
    # Clone the deploy repo.
    # If repo_ref is set (tag/commit), pin to that exact version.
    git clone --depth 1 --branch ${repo_branch} ${repo_url} /opt/clawdbot-docker-deploy
    cd /opt/clawdbot-docker-deploy
    if [ -n "${repo_ref}" ]; then
      echo "[cloud-init] pinning deploy repo to ref: ${repo_ref}"
      # Fetch the ref and checkout detached HEAD.
      git fetch --depth 1 origin "${repo_ref}" || git fetch --depth 1 origin "refs/tags/${repo_ref}:refs/tags/${repo_ref}"
      git checkout --detach FETCH_HEAD
    fi
    EOF

  - cp -f /root/clawdbot.env /opt/clawdbot-docker-deploy/.env
  - |
    cat > /opt/clawdbot-docker-deploy/Caddyfile <<'EOF'
    ${domain} {
      # HTTPS via Let's Encrypt. Email is set via Caddy global options.
      reverse_proxy clawdbot:18789
    }

    {
      email ${caddy_email}
    }
    EOF
  - cd /opt/clawdbot-docker-deploy && docker compose -f docker-compose.vps.yml up -d
