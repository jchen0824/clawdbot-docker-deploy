# Moltbot (Clawdbot) Docker Deployment - Environment Variables
# Copy to .env and fill in your secrets.

# ---- Persistence (host paths) ----
# On Mac, keep these inside the repo (gitignored).
# On a VPS, set these to something like /root/.clawdbot and /root/clawd
CLAWDBOT_CONFIG_DIR=./data
CLAWDBOT_WORKSPACE_DIR=./workspace

# ---- Gateway ----
GATEWAY_PORT=18790
# Generate once: openssl rand -hex 32
GATEWAY_AUTH_TOKEN=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=

# Back-compat single owner id (optional if you set TELEGRAM_ALLOW_FROM)
TELEGRAM_OWNER_ID=

# Preferred: JSON array of allowed Telegram user IDs (strings or numbers)
# Example: ["1459204134","123456789"]
TELEGRAM_ALLOW_FROM=

# ---- Model provider ----
# Option 1: Anthropic API key (usage-based billing, simple auth)
ANTHROPIC_API_KEY=

# Option 2: Anthropic setup-token (uses Claude subscription, creates token auth profile)
# Generate with: claude setup-token
# This creates an auth profile like "anthropic:default" with mode "token"
ANTHROPIC_SETUP_TOKEN=

# Option 3: Route models via LiteLLM proxy instead of direct Anthropic
# For Docker Desktop on Mac, containers can reach host services via host.docker.internal
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=

# ---- Optional tools ----
GH_TOKEN=

# Enables web_search via Brave
BRAVE_API_KEY=
