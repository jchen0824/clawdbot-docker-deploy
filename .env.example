# Clawdbot Docker Deployment - Environment Variables
# Copy this file to .env and fill in your secrets

# === REQUIRED ===

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# LiteLLM Master Key (generate a strong random key)
# You can generate one with: openssl rand -hex 32
LITELLM_MASTER_KEY=

# === OPTIONAL ===

# OpenAI API Key (for ChatGPT OAuth or OpenAI models)
OPENAI_API_KEY=

# GitHub Token (for GitHub CLI in sandbox)
GH_TOKEN=

# Brave Search API Key (for web search)
BRAVE_API_KEY=

# Gateway Port (default: 18789)
GATEWAY_PORT=18789

# === SECURITY ===

# Gateway Auth Token (auto-generated on first run if not set)
# Generate with: openssl rand -hex 24
GATEWAY_AUTH_TOKEN=
